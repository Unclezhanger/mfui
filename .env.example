# Database Configuration
# NOTE: SQLite relative paths are resolved against the directory containing
# prisma/schema.prisma (NOT the project root). "../db/custom.db" therefore
# points to <project root>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# Next.js Application Port (optional)
# MF_PORT_NEXT=3010

# Job Runner Service Port (optional, local only)
# MF_PORT_JOB=3001
